# ---- 构建产物（tools/build_dist.py 可随时重新生成）----
dist/

# ---- 打包/签名文件（私钥绝不能入库）----
*.zip
*.crx
*.pem

# ---- 临时文件 ----
*.tmp.json
otx_tmp.json
*.log

# ---- Python ----
__pycache__/
*.pyc

# ---- Node（未来若引入构建工具链）----
node_modules/

# ---- 编辑器 / 工具本地状态 ----
.zcode/
.vscode/
.idea/

# ---- 操作系统 ----
.DS_Store
Thumbs.db
desktop.ini

# ---- 例外：测试桩需要随仓库分发（模拟钓鱼页的下载链接目标）----
!test/pages/files/*.zip

# ---- 项目文档（仅本地保留，不上传远程）----
docs/

# ---- GitHub API 临时响应 ----
gh_*.json
