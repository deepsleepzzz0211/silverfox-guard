# ---- 构建产物（tools/build_dist.py 可随时重新生成）----
dist/
release_notes.md

# ---- 打包/签名文件（私钥绝不能入库）----
*.zip
*.crx
*.pem

# ---- 密钥与环境（绝不入库）----
.env
.env.*
!.env.example

# ---- 临时文件（调研/发版过程产物）----
*.log
*.tmp.json
otx_tmp.json
gh_*.json
gh_*.txt
notes_*.md
tmp_*.md

# ---- Python ----
__pycache__/
*.pyc
.venv/
venv/

# ---- Node（未来若引入构建工具链）----
node_modules/

# ---- 编辑器 / 工具本地状态 ----
.zcode/
.vscode/
.idea/

# ---- 项目文档（仅本地保留，不上传远程）----
docs/

# ---- 操作系统 ----
.DS_Store
Thumbs.db
desktop.ini

# ---- 例外：测试桩需要随仓库分发（模拟钓鱼页的下载链接目标）----
!test/pages/files/*.zip
